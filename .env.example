# Copie para .env.local e preencha. Depois REINICIE o `npm run dev` —
# o Next só lê variáveis NEXT_PUBLIC_* no boot.

# ─── Formulário /form → GoHighLevel ──────────────────────────────────
# URL do Inbound Webhook do GoHighLevel.
# Onde achar: Automation > Workflows > seu workflow > trigger
# "Inbound Webhook" > copiar a URL.
NEXT_PUBLIC_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/SEU_LOCATION_ID/webhook-trigger/SEU_TRIGGER_ID

# Metadado enviado no payload, para identificar a origem na automação.
NEXT_PUBLIC_GHL_FORM_ID=sKs8D7g4cdsZRMTZdF0P

# ─── Formulário /form-master → ClickUp ───────────────────────────────
# SEM o prefixo NEXT_PUBLIC_ de propósito: essas variáveis só podem
# existir no servidor. Com o prefixo, o token iria para o navegador.
#
# Token pessoal do ClickUp (começa com pk_).
# Onde achar: Configurações > Apps > API Token > Generate.
# Gere na conta de um usuário de serviço — as tarefas aparecem como
# criadas pelo dono do token.
CLICKUP_TOKEN=pk_00000000_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Id da lista de membros que recebe as respostas (comentário na tarefa do
# membro quando ele já existe; tarefa nova quando não existe).
# Onde achar: rode `node scripts/clickup-lists.mjs`, ou pegue o número
# na URL ao abrir a lista no ClickUp.
CLICKUP_LIST_ID=901234567890

# ─── Formulário /form-master → Supabase ──────────────────────────────
# Projeto "Membros DC" (ref jyadqbbndxrfgosmnycr) — separado do "Banco
# Digital Club", que é do app e do painel. É o registro que garante que a
# resposta não se perde se o ClickUp falhar.
#
# Também SEM o prefixo NEXT_PUBLIC_: a service_role IGNORA a RLS, e no
# navegador daria a qualquer visitante acesso total à tabela.
SUPABASE_URL=https://SEU_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
